# Copy to .env and fill in. .env is gitignored and never committed.

# Long-lived Claude Code OAuth token for headless `claude -p` inside the
# container. Generate it on the host with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Host directory holding the local GGUF model, mounted read-only at /models.
# Leave unset to run Claude-only. The model filename is set via NUMEN_MODEL_PATH
# in docker-compose.yml.
#   NUMEN_MODELS_DIR=D:/models

# Vector memory: drop a sentence-transformer (config.json, tokenizer.json,
# model.safetensors) in a subdir of NUMEN_MODELS_DIR and point NUMEN_EMBED_MODEL_DIR
# at it (default /models/all-MiniLM-L6-v2). Absent -> recall by exact labels only.
#   NUMEN_EMBED_MODEL_DIR=/models/all-MiniLM-L6-v2

# Optional behaviour knobs.
# NUMEN_API_TOKEN: when set, every endpoint except /health requires
#   `Authorization: Bearer <token>` (unset = open API, fine on localhost).
# NUMEN_PROACTIVE: 1/true lets the agent explore its biggest knowledge gap on its
#   own while idle (Active Inference). It delegates to the LLM on a timer, so it is
#   off by default to spare the Claude quota.
# NUMEN_AUTONOMY_LEVEL: the autonomy ceiling (0-5) for self-initiated actions. A
#   self-initiated action above this is held for the operator's approval instead of
#   running. Default 1 (explore): the agent investigates on its own, but every
#   self-modifying action (4 improve, 5 deploy) waits for approval. Operator-
#   invoked endpoints (/act, /improve, /deploy) keep operator authority regardless.
#   NUMEN_API_TOKEN=
#   NUMEN_PROACTIVE=1
#   NUMEN_AUTONOMY_LEVEL=1
# NUMEN_AUTONOMOUS_IMPROVE: 1/true lets the agent rewrite and redeploy its own
#   source once exploration is exhausted - it critiques its self-metrics, picks an
#   improvement axis (rate-limited to one self-deploy per 6h, per-module cooldown,
#   a second confirming critique), notifies you over Telegram, and deploys without
#   asking. The sandboxed build+test+clippy gate, the writable allowlist, and the
#   kill switch are the safety net. Off by default; needs the self-improve image
#   (toolchain + workshop) and NUMEN_API_TOKEN. Enable deliberately.
#   NUMEN_AUTONOMOUS_IMPROVE=1

# NUMEN_FEEDS: space- or comma-separated RSS/Atom feed URLs the scheduler fetches
#   on each idle tick, dedup'd by entry id (only new entries delegate to the LLM).
#   Empty disables scheduled ingestion.
#   NUMEN_FEEDS=https://feeds.bbci.co.uk/news/science_and_environment/rss.xml

# Telegram effector: with both set, the proactive loop pushes its discoveries to
# this chat. Create a bot with @BotFather for the token; get the chat id by
# messaging the bot, then reading api.telegram.org/bot<TOKEN>/getUpdates.
#   TELEGRAM_BOT_TOKEN=
#   TELEGRAM_CHAT_ID=

# Self-improvement. The single image is self-improvement-capable but DORMANT by
# default: docker-compose.yml runs the plain kernel (no supervisor, source not
# wired). To enable it, run docker-compose.selfimprove.yml instead, which runs the
# SAME image under the supervisor (it wires NUMEN_SRC_DIR, NUMEN_BUILD_FEATURES,
# seccomp=unconfined, and the markers/kill-switch). The only self-improvement knob
# that belongs in .env is the autonomous loop:
# NUMEN_AUTONOMOUS_IMPROVE: 1/true lets the agent critique its self-metrics, rewrite
#   a reasoning module, and redeploy itself once exploration is exhausted
#   (rate-limited, cooldown-gated, sandboxed gate). Off by default; only effective in
#   the self-improve compose, and needs NUMEN_API_TOKEN + CLAUDE_CODE_OAUTH_TOKEN.
#   NUMEN_AUTONOMOUS_IMPROVE=1
# The gate sandbox (bubblewrap) needs unprivileged user namespaces; the self-improve
# compose sets --security-opt seccomp=unconfined. Set NUMEN_GATE_NO_SANDBOX=1 to opt
# out where userns is impossible (the gate then runs unconfined, less safe).
#   NUMEN_GATE_NO_SANDBOX=1
